<?xml version="1.0" encoding="utf-8"?>
<!-- One chore card on the dashboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Tap to mark as done -->
    <ImageView
        android:id="@+id/check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_check"
        android:contentDescription="Mark as done"
        android:padding="3dp"
        android:src="@drawable/check_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title and priority badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/dark_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Delete chore"
                android:src="@drawable/ic_delete"
                android:tint="@color/priority_urgent" />
        </LinearLayout>

        <!-- Days of the week (green = active) -->
        <LinearLayout
            android:id="@+id/days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView style="@style/MiniDay" android:text="M" />
            <TextView style="@style/MiniDay" android:text="T" />
            <TextView style="@style/MiniDay" android:text="W" />
            <TextView style="@style/MiniDay" android:text="T" />
            <TextView style="@style/MiniDay" android:text="F" />
            <TextView style="@style/MiniDay" android:text="S" />
            <TextView style="@style/MiniDay" android:text="S" />
        </LinearLayout>

        <!-- Room and duration -->
        <TextView
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="6dp"
            android:drawableTint="@color/green"
            android:gravity="center_vertical"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
