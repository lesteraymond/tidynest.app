<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@color/page_background"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/topBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/dark_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Add Chore"
            android:textColor="@color/dark_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_green"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/FormContainer"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="Back"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/dark_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/formTitle"
                        android:text="Create New Chore"
                        android:textColor="@color/dark_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Household Routine"
                        android:textColor="@color/gray_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Cancel"
                    android:textColor="@color/gray_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lightbulb"
                    android:tint="@color/dark_green" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tip"
                        android:textColor="@color/dark_green"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Short, regular chores are easier to keep up than big weekly clean-ups."
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SectionRow">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Chore Title" />

                <TextView
                    style="@style/SideNote"
                    android:text="Required"
                    android:textColor="@color/green"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout style="@style/FieldBox">

                <AutoCompleteTextView
                    android:id="@+id/choreTitle"
                    style="@style/FieldInput"
                    android:layout_marginStart="4dp"
                    android:completionThreshold="1"
                    android:dropDownVerticalOffset="8dp"
                    android:hint="Pick a chore or type your own"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/titleDropdown"
                    style="@style/FieldIcon"
                    android:contentDescription="Show common chores"
                    android:src="@drawable/ic_dropdown" />

                <ImageView
                    android:id="@+id/clearTitle"
                    style="@style/FieldIcon"
                    android:contentDescription="Clear"
                    android:src="@drawable/ic_clear" />
            </LinearLayout>

            <LinearLayout style="@style/SectionRow">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Room or Area" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/roomKitchen"
                        style="@style/RoomChip"
                        android:text="Kitchen" />

                    <TextView
                        android:id="@+id/roomBathroom"
                        style="@style/RoomChip"
                        android:text="Bathroom" />

                    <TextView
                        android:id="@+id/roomLiving"
                        style="@style/RoomChip"
                        android:text="Living Room" />

                    <TextView
                        android:id="@+id/roomBedroom"
                        style="@style/RoomChip"
                        android:text="Bedroom" />

                    <TextView
                        android:id="@+id/roomLaundry"
                        style="@style/RoomChip"
                        android:text="Laundry" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout style="@style/SectionRow">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Priority Level" />

                <TextView
                    style="@style/SideNote"
                    android:text="Select single urgency" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/priorityLow"
                    style="@style/PriorityCard"
                    android:layout_marginEnd="5dp"
                    android:tag="Low">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            style="@style/PriorityDot"
                            android:backgroundTint="@color/priority_low" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView style="@style/PriorityRadio" />
                    </LinearLayout>

                    <TextView
                        style="@style/PriorityTitle"
                        android:text="Low" />

                    <TextView
                        style="@style/PrioritySub"
                        android:text="Relaxed pace" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/priorityMedium"
                    style="@style/PriorityCard"
                    android:layout_marginStart="5dp"
                    android:tag="Medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            style="@style/PriorityDot"
                            android:backgroundTint="@color/priority_medium" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView style="@style/PriorityRadio" />
                    </LinearLayout>

                    <TextView
                        style="@style/PriorityTitle"
                        android:text="Medium" />

                    <TextView
                        style="@style/PrioritySub"
                        android:text="Standard chore" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/priorityHigh"
                    style="@style/PriorityCard"
                    android:layout_marginEnd="5dp"
                    android:tag="High">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            style="@style/PriorityDot"
                            android:backgroundTint="@color/priority_high" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView style="@style/PriorityRadio" />
                    </LinearLayout>

                    <TextView
                        style="@style/PriorityTitle"
                        android:text="High" />

                    <TextView
                        style="@style/PrioritySub"
                        android:text="Important today" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/priorityUrgent"
                    style="@style/PriorityCard"
                    android:layout_marginStart="5dp"
                    android:tag="Urgent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            style="@style/PriorityDot"
                            android:backgroundTint="@color/priority_urgent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView style="@style/PriorityRadio" />
                    </LinearLayout>

                    <TextView
                        style="@style/PriorityTitle"
                        android:text="Urgent" />

                    <TextView
                        style="@style/PrioritySub"
                        android:text="Do it now" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SectionRow">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Repeat" />

                <TextView
                    android:id="@+id/daysActive"
                    style="@style/SideNote"
                    android:text="0 days active"
                    android:textColor="@color/green"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dayMon"
                    style="@style/DayBox"
                    android:text="MON" />

                <TextView
                    android:id="@+id/dayTue"
                    style="@style/DayBox"
                    android:text="TUE" />

                <TextView
                    android:id="@+id/dayWed"
                    style="@style/DayBox"
                    android:text="WED" />

                <TextView
                    android:id="@+id/dayThu"
                    style="@style/DayBox"
                    android:text="THU" />

                <TextView
                    android:id="@+id/dayFri"
                    style="@style/DayBox"
                    android:text="FRI" />

                <TextView
                    android:id="@+id/daySat"
                    style="@style/DayBox"
                    android:text="SAT" />

                <TextView
                    android:id="@+id/daySun"
                    style="@style/DayBox"
                    android:text="SUN" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned to"
                    android:textColor="@color/dark_text"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/FieldBox"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">

                    <ImageView
                        style="@style/FieldIcon"
                        android:src="@drawable/ic_person" />

                    <EditText
                        android:id="@+id/memberName"
                        style="@style/FieldInput"
                        android:hint="Name"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Time"
                    android:textColor="@color/dark_text"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/timeRow"
                    style="@style/FieldBox"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">

                    <ImageView
                        style="@style/FieldIcon"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/choreTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/dark_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="Estimated Duration"
                    android:textColor="@color/dark_text"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/duration15"
                        style="@style/DurationChip"
                        android:text="15 mins" />

                    <TextView
                        android:id="@+id/duration30"
                        style="@style/DurationChip"
                        android:text="30 mins" />

                    <TextView
                        android:id="@+id/duration45"
                        style="@style/DurationChip"
                        android:text="45 mins" />

                    <TextView
                        android:id="@+id/duration60"
                        style="@style/DurationChip"
                        android:text="1 hr" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="Notes"
                    android:textColor="@color/dark_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_notes"
                    android:gravity="top"
                    android:hint="e.g. Use the non-scratch sponge for Teflon pans."
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:padding="14dp"
                    android:textColor="@color/dark_text"
                    android:textColorHint="@color/gray_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_light"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/dark_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Push Reminder"
                            android:textColor="@color/dark_text"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notify at the chore's time on active days"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/reminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:id="@+id/saveLabel"
                    android:text="Save Chore"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </ScrollView>
</LinearLayout>
